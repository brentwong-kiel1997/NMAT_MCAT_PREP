#!/usr/bin/env bash
# Git post-receive: deploy pushed commits via staging validation + atomic swap.
#
# The checkout lands in $STAGING (NOT the live directory); scripts/deploy.sh
# gates it there (check → migrate → validate_content → collectstatic) and only
# then renames it onto the live path and restarts gunicorn. See deploy.sh for
# the reasoning.
set -euo pipefail

BARE="/home/ubuntu/repos/django-wsgi.git"
STAGING="/home/ubuntu/runtime/staging"

mkdir -p "$STAGING"
rm -rf "$STAGING"
GIT_WORK_TREE="$STAGING" GIT_DIR="$BARE" git checkout -f main 2>/dev/null \
  || GIT_WORK_TREE="$STAGING" GIT_DIR="$BARE" git checkout -f master

chmod +x "$STAGING/scripts/deploy.sh" 2>/dev/null || true
exec "$STAGING/scripts/deploy.sh"
