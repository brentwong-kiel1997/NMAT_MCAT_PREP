# Gabay runtime configuration — copy to .env and fill in real values.
# .env is gitignored; the app reads it directly (portal/envfile.py),
# so nothing needs to be exported into the shell environment.
#
# Lookup order: GABAY_ENV_FILE, <repo>/.env, then the server runtime
# locations under GABAY_RUNTIME_DIR (defaults documented in portal/envfile.py).
#
# Verify with: python manage.py env_status

# AI coach keys are managed in the admin UI (Manage → Models).
# The MINIMAX_* values below are only used ONCE to seed that table
# (manage.py ensure_ai_model); afterwards they can stay empty.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
