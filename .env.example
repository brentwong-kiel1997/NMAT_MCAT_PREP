# Gabay runtime configuration — copy to .env and fill in real values.
# .env is gitignored; the app reads it directly (portal/envfile.py),
# so nothing needs to be exported into the shell environment.
#
# Lookup order: GABAY_ENV_FILE, <repo>/.env, /home/ubuntu/runtime/.env,
# /home/ubuntu/runtime/secrets/minimax.env
#
# Verify with: python manage.py env_status

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
